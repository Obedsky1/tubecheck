# Local Development Env
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/shieldnetwork
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/shieldnetwork
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
JWT_SECRET_KEY=local-dev-jwt-secret-key-that-is-long-enough-to-be-secure
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
APP_NAME=ShieldNetwork AI
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
EMBEDDING_PROVIDER=local
PROMETHEUS_ENABLED=true

# ── API Keys (Add your actual keys here to enable production features) ──
YOUTUBE_API_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

OPENAI_API_KEY=""
HIVE_API_KEY=""
GEMINI_API_KEY=""
ELEVENLABS_API_KEY=""

# ── Optional: AWS S3 / Supabase Storage ──
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ==============================================================================
# ShieldNetwork AI - Environment Configuration Example
# Copy this file to .env in the project root for local development.
# ==============================================================================

# ── Backend Configuration ─────────────────────────────────────────────────────

# Database Configuration (Supabase or Local Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/shieldnetwork
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/shieldnetwork

# Redis Configuration (Message broker and Cache)
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Authentication (JWT Settings)
JWT_SECRET_KEY=change-me-in-production-use-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# YouTube Data API v3 (Required for sync functionality)
YOUTUBE_API_KEY=your_youtube_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Deepgram API Key (For audio transcripts)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Sightengine API Credentials (For deepfake and content safety scanning)
SIGHTENGINE_API_USER=your_sightengine_api_user_here
SIGHTENGINE_API_SECRET=your_sightengine_api_secret_here

# ElevenLabs API Key (For synthetic voice classification)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Sentry DSN (For error tracking)
SENTRY_DSN=

# Prometheus & Metrics
PROMETHEUS_ENABLED=true

# Storage (AWS S3 or Supabase Storage bucket)
S3_BUCKET=creatorshield-media
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET=your_r2_bucket_name_here
R2_PUBLIC_URL=https://your-custom-or-r2-dev-domain.com

# General App Config
APP_NAME=ShieldNetwork AI
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
EMBEDDING_PROVIDER=local

# ── Frontend Configuration ────────────────────────────────────────────────────

# Frontend environment variables must start with NEXT_PUBLIC_ to be exposed to browser
NEXT_PUBLIC_API_URL=http://localhost:8000/api
